{
  "name": "@ankora/client",
  "version": "0.1.0",
  "private": true,
  "description": "Ankora chain client: pool views, wallet-agnostic actions, quote maths mirrored from ankora-core, and the testnet relay + settle keeper",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit",
    "keeper": "tsx bin/keeper.ts",
    "deploy:testnet": "tsx bin/deploy-testnet.ts",
    "local": "tsx bin/local-chain.ts"
  },
  "dependencies": {
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
