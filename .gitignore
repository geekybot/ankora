# Only the working code is in this repo: contracts, the chain client, and the UI.
/*
!/.gitignore
!/README.md
!/LICENSE
!/contracts/
!/client/
!/.github/
!/scripts/
!/app/
!/site/
!/PRODUCT.md
!/research/

# Build output and tool state
target/
node_modules/
.DS_Store
design/.impeccable/

# Secrets never belong here
.env
.env.*
*.pem
dist/
!.env.example

# Site build artefacts
site/shots/
site/.taste-skill/
!.env.production
dist-web/
